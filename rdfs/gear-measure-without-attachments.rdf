    <bib:Article rdf:about="https://dx.plos.org/10.1371/journal.pone.0240735">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:1932-6203"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
