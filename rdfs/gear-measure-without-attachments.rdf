        <dc:subject>
           <z:AutomaticTag><rdf:value>/unread</rdf:value></z:AutomaticTag>
        </dc:subject>
        <dc:subject>
           <z:AutomaticTag><rdf:value>齿轮</rdf:value></z:AutomaticTag>
        </dc:subject>
